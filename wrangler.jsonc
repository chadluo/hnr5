/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hnr5",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"upload_source_maps": true,
	/**
	 * Cron Triggers — fill the related-story index independent of site traffic (see
	 * src/lib/cron.ts). Offset a few minutes past the clock so the batch of HN/OpenRouter/
	 * Workers AI calls doesn't land at the same moment every other :00 cron job on the
	 * internet fires. Must match TOP_CRON / BEST_CRON in src/lib/cron.ts exactly.
	 */
	"triggers": {
		"crons": [
			"7 */4 * * *",
			"13 3 * * *"
		]
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// TODO before deploy: run `wrangler kv namespace create CACHE` and replace this id.
	// Local dev works fine with this placeholder (uses local Miniflare storage).
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "d581c61ea94b48b780dfbdeb523fe84f"
		}
	],
	/**
	 * Workers AI — embeddings for related-story search (@cf/baai/bge-base-en-v1.5).
	 * No local simulation exists, so this binding always talks to the real account.
	 */
	"ai": {
		"binding": "AI"
	},
	/**
	 * Vectorize — story embeddings for related-story search. Create it before deploy:
	 *   wrangler vectorize create hnr5-stories --dimensions=768 --metric=cosine
	 *   wrangler vectorize create-metadata-index hnr5-stories --propertyName=at --type=number
	 * Dimensions and metric are immutable, and the 0.80 score threshold in
	 * src/lib/related.ts is calibrated for cosine on this exact model.
	 * The metadata index must exist before the first upsert or it cannot be
	 * backfilled; no query filters on `at` yet, it is created for later use.
	 * `remote: true` because Vectorize has no local simulation either — `pnpm dev`
	 * reads the production index (writes are skipped in dev, see src/server/related.ts).
	 */
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "hnr5-stories",
			"remote": true
		}
	]
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}